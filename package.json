{
  "name": "qingzhu-video-converter",
  "version": "1.0.0",
  "description": "面向普通用户的桌面视频格式转换器，使用 FFmpeg 在本机处理视频。",
  "main": "src/main.js",
  "author": "Qingzhu Video Converter contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.qingzhu.video-converter",
    "productName": "轻转视频",
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
